# Supabase (required for multi-device cloud sessions)
# Create a project at https://supabase.com — then Project Settings → API
# Anon key must be ASCII-only and start with eyJ (JWT) or sb_ (publishable).
# Do not paste placeholders with ellipsis or non-ASCII characters — that crashes login.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Server-only (seed script). Never put this in Vercel frontend env.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
